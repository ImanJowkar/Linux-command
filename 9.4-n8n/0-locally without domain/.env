# Use "localhost" if you only open n8n on this machine.
# Use your LAN IP (e.g. 192.168.1.50) if other devices/services on your network
# need to reach the editor or call webhooks.
N8N_HOST=localhost
N8N_PORT=5678

# Must match how you open n8n in the browser; keep the trailing slash
N8N_BASE_URL=http://localhost:5678/

# Generate once with:  openssl rand -hex 32
# Don't change it later, or saved credentials can no longer be decrypted
N8N_ENCRYPTION_KEY=change_me_to_a_long_random_string

TIMEZONE=Asia/Tehran